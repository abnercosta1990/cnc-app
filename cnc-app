}

function findMaterial(name) {
  return materials.find((row) => row[0] === name) || materials.find((row) => row[0] === 'Alumínio 7475')
}

function apBandRef(diameter, band) {
  const d = Number.isFinite(diameter) && diameter > 0 ? diameter : 0
  if (d <= 0) return { ae: 0, ap: 0, fz: 0 }

  if (band === 3) {
    const rpm = 13000 * 10 / d
    const vf = 3000 * d / 10
    const z = 2
    return { ae: d, ap: d * 0.45, fz: vf / (rpm * z) }
  }
  if (band === 4.5) {
    const rpm = 13000 * 10 / d
    const vf = 3000 * d / 10
    const z = 2
    return { ae: d, ap: d * 0.4, fz: vf / (rpm * z) }
  }
  if (band === 6) {
    const rpm = 9000 * 12 / d
    const vf = 2000 * d / 12
    const z = 2
    return { ae: d, ap: d * 0.25, fz: vf / (rpm * z) }
  }
  if (band === 7.5) {
    const rpm = 8000 * 8 / d
    const vf = 1000 * d / 8
    const z = 2
    return { ae: d, ap: d * 0.1, fz: vf / (rpm * z) }
  }
  const rpm = 8000 * 8 / d
  const vf = 1000 * d / 8
  const z = 2
  return { ae: d, ap: d * 0.05, fz: vf / (rpm * z) }
}

function lerp(a, b, t) {
  return a + (b - a) * t
}

function apInterpolatedRef(diameter, ld) {
  const d = Number.isFinite(diameter) && diameter > 0 ? diameter : 0
  if (d <= 0 || !Number.isFinite(ld)) return { ae: 0, ap: 0, fz: 0 }
  const pts = [3, 4.5, 6, 7.5, 9]
  if (ld <= 3) return apBandRef(d, 3)
  if (ld >= 9) return apBandRef(d, 9)
  for (let i = 0; i < pts.length - 1; i++) {
    const a = pts[i]
    const b = pts[i + 1]
    if (ld >= a && ld <= b) {
      const left = apBandRef(d, a)
      const right = apBandRef(d, b)
      const t = (ld - a) / (b - a)
      return { ae: lerp(left.ae, right.ae, t), ap: lerp(left.ap, right.ap, t), fz: lerp(left.fz, right.fz, t) }
    }
  }
  return apBandRef(d, 3)
}

function aeRef(diameter) {
  const d = Math.round(diameter)
  if (!Number.isFinite(d) || d <= 0) return { ae: 0, ap: 0, fz: 0, rpm: 0, vf: 0 }
  return AE_TABLE[d] || AE_TABLE[16]
}

function curvaDeflexao(valorLd) {
  if (valorLd <= 3) return 1
  if (valorLd <= 4.5) return 1 + ((valorLd - 3) / (4.5 - 3)) * 0.1
  if (valorLd <= 6) return 1.1 + ((valorLd - 4.5) / (6 - 4.5)) * 0.15
  if (valorLd <= 7.5) return 1.25 + ((valorLd - 6) / (7.5 - 6)) * 0.25
  if (valorLd <= 9) return 1.5 + ((valorLd - 7.5) / (9 - 7.5)) * 0.3
  return 1.8 + Math.min(1.2, (valorLd - 9) * 0.25)
}

function buildCalcBase(input) {
  const B2 = input.modo || 'Topo'
  const B3 = input.material
  const B4 = toNumber(input.diam)
  const B5 = toNumber(input.bal)
  const B6 = toNumber(input.rpm)
  const B7 = toNumber(input.vf)
  const B8 = toNumber(input.z)
  const B9 = toNumber(input.ae)
  const B10 = toNumber(input.ap)

  const materialRow = findMaterial(B3)
  const B13 = Math.max(toNumber(materialRow?.[1]), 0)
  const B14 = toNumber(materialRow?.[2]) || 0.25
  const B12 = B13 === 650 ? 1 : B13 / 650

  const B20 = B6 * B8 === 0 ? 0 : B7 / (B6 * B8)
  const B21 = B4 > 0 ? B20 * Math.sqrt(B9 / B4) : 0
  const B22 = B13 > 0 && B10 > 0 && B21 > 0 ? B13 * B10 * Math.pow(B21, 1 - B14) : 0
  const B24 = B4 > 0 ? B5 / B4 : 0
  const B25 = B4 > 0 && B5 > 0 ? (64 * B22 * Math.pow(B5, 3)) / (3 * 600000 * Math.PI * Math.pow(B4, 4)) : 0

  const apRef = apInterpolatedRef(B4, B24)
  const lateralRef = aeRef(B4)
  let B26 = ''

  if (B2 === 'Topo') {
    if (apRef.ae > 0 && apRef.ap > 0 && apRef.fz > 0 && B20 > 0) {
      B26 = B12 * 100 * (B9 / apRef.ae) * (B10 / apRef.ap) * (B20 / apRef.fz)
    }
  } else {
    if (lateralRef.ae > 0 && lateralRef.ap > 0 && lateralRef.fz > 0 && B20 > 0) {
      const ldReferencia = 77 / 16
      const penalizacaoLD = curvaDeflexao(B24) / curvaDeflexao(ldReferencia)
      const penalizacaoBalanco = Math.pow(Math.max(0.2, B5 / (16 * ldReferencia)), 1.2)
      B26 = B12 * 100 * (B9 / lateralRef.ae) * (B10 / lateralRef.ap) * (B20 / lateralRef.fz) * penalizacaoLD * penalizacaoBalanco
    }
  }

  const effort = Number.isFinite(B26) ? B26 : 0
  const B18 = effort > 0 ? B25 / (effort / 100) : 0
  const B23 = effort > 0 ? B22 / (effort / 100) : 0
  const B28 = B22 * B4 / 2000

  return {
    esforco: effort,
    deflexao: B25,
    deflexaoLimite: B18,
    forcorte: B22,
    forcorteLimite: B23,
    ld: B24,
    torque: B28,
    fzReal: B20,
    hm: B21,
    apRef,
    lateralRef,
  }
}

export default function CNCProMaxSite() {
  const [logged, setLogged] = useState(false)
  const [input, setInput] = useState(defaults)
  const [login, setLogin] = useState({ user: '', pass: '' })
  const [installPrompt, setInstallPrompt] = useState(null)
  const [isInstalled, setIsInstalled] = useState(false)

  useEffect(() => {
    const handler = (event) => {
      event.preventDefault()
      setInstallPrompt(event)
    }

    const installedHandler = () => {
      setIsInstalled(true)
      setInstallPrompt(null)
    }

    window.addEventListener('beforeinstallprompt', handler)
    window.addEventListener('appinstalled', installedHandler)

    if (window.matchMedia('(display-mode: standalone)').matches) {
      setIsInstalled(true)
    }

    return () => {
      window.removeEventListener('beforeinstallprompt', handler)
      window.removeEventListener('appinstalled', installedHandler)
    }
  }, [])

  const installApp = async () => {
    if (!installPrompt) return
    installPrompt.prompt()
    await installPrompt.userChoice
    setInstallPrompt(null)
  }

  const setField = (key, value) => {
    const rawValue = String(value)
    setInput((previous) => {
      const next = { ...previous, [key]: rawValue }
      const D = toNumber(key === 'diam' ? rawValue : next.diam)
      const Z = toNumber(key === 'z' ? rawValue : next.z)
      const N = toNumber(key === 'rpm' ? rawValue : next.rpm)
      const VC = toNumber(key === 'vc' ? rawValue : next.vc)
      const VF = toNumber(key === 'vf' ? rawValue : next.vf)
      const FZ = toNumber(key === 'fz' ? rawValue : next.fz)

      if (key === 'vc') {
        next.syncSource = 'vc'
        next.rpm = D > 0 && VC > 0 ? String(Math.round((VC * 1000) / (Math.PI * D))) : ''
      }
      if (key === 'rpm') {
        next.syncSource = 'rpm'
        next.vc = D > 0 && N > 0 ? ((N * Math.PI * D) / 1000).toFixed(1) : ''
      }
      if (key === 'diam') {
        if (next.syncSource === 'vc') next.rpm = D > 0 && VC > 0 ? String(Math.round((VC * 1000) / (Math.PI * D))) : ''
        if (next.syncSource === 'rpm') next.vc = D > 0 && N > 0 ? ((N * Math.PI * D) / 1000).toFixed(1) : ''
      }

      const finalRpm = toNumber(next.rpm)
      const finalZ = toNumber(next.z)

      if (key === 'vf') {
        next.syncSource = 'vf'
        next.fz = finalZ > 0 && finalRpm > 0 && VF > 0 ? (VF / (finalRpm * finalZ)).toFixed(5) : ''
      }
      if (key === 'fz') {
        next.syncSource = 'fz'
        next.vf = finalZ > 0 && finalRpm > 0 && FZ > 0 ? String(Math.round(FZ * finalRpm * finalZ)) : ''
      }
      if (['z', 'rpm', 'vc', 'diam'].includes(key)) {
        if (next.syncSource === 'fz' && next.fz !== '' && finalRpm > 0 && finalZ > 0) next.vf = String(Math.round(toNumber(next.fz) * finalRpm * finalZ))
        if (next.syncSource === 'vf' && next.vf !== '' && finalRpm > 0 && finalZ > 0) next.fz = (toNumber(next.vf) / (finalRpm * finalZ)).toFixed(5)
      }
      return next
    })
  }

  const reset = () => setInput(prev => ({ ...prev, diam: '', bal: '', rpm: '', vf: '', z: '', ae: '', ap: '', vc: '', fz: '', syncSource: '' }))
  const output = useMemo(() => buildCalcBase(input), [input])

  if (!logged) {
    return <LoginScreen login={login} setLogin={setLogin} onEnter={() => setLogged(true)} />
  }

  return (
    <div className="min-h-screen bg-[radial-gradient(circle_at_top_left,#0c4a6e_0%,#09090b_35%,#050505_100%)] text-zinc-100">
      <header className="sticky top-0 z-20 border-b border-sky-400/20 bg-zinc-950/80 backdrop-blur-xl">
        <div className="mx-auto flex max-w-7xl items-center justify-between px-4 py-3">
          <div className="flex items-center gap-3">
            <div className="flex h-11 w-11 items-center justify-center rounded-2xl bg-sky-500/20 text-xl font-black text-sky-300 ring-1 ring-sky-300/40">C</div>
            <div>
              <h1 className="text-xl font-black tracking-wide text-white">CNC PRO MAX</h1>
              <p className="text-xs text-sky-300">Force Calculator • NX CAM Style</p>
            </div>
          </div>
          <div className="flex items-center gap-2">
            {!isInstalled && (
              <button onClick={installApp} className="rounded-xl bg-sky-600 px-4 py-2 text-sm font-bold text-white hover:bg-sky-500">
                Instalar app
              </button>
            )}
            <button onClick={() => setLogged(false)} className="rounded-xl border border-zinc-700 px-4 py-2 text-sm text-zinc-300 hover:border-sky-400 hover:text-white">Sair</button>
          </div>
        </div>
      </header>

      <main className="mx-auto grid max-w-7xl gap-4 p-4 lg:grid-cols-[1.05fr_1.3fr]">
        <section className="rounded-3xl border border-zinc-700/80 bg-zinc-950/75 p-4 shadow-2xl shadow-black/40">
          <div className="mb-4 flex items-center justify-between">
            <h2 className="text-lg font-bold text-sky-300">Entrada</h2>
            <span className="rounded-full border border-sky-400/30 bg-sky-400/10 px-3 py-1 text-xs text-sky-200">Online</span>
          </div>

          <div className="grid gap-3 sm:grid-cols-2">
            <SelectField label="Modo de usinagem" value={input.modo} onChange={(v)=>setField('modo',v)} options={['Topo','Lateral']} />
            <SelectField label="Material" value={input.material} onChange={(v)=>setField('material',v)} options={materials.map(row => row[0])} />
            <SelectField label="Diâmetro D (mm)" value={input.diam} onChange={(v)=>setField('diam',v)} options={diameterOptions} allowBlank />
            <InputField label="Balanço L (mm)" value={input.bal} onChange={(v)=>setField('bal',v)} />
            <InputField label="RPM" value={input.rpm} onChange={(v)=>setField('rpm',v)} />
            <InputField label="Vc (m/min)" value={input.vc} onChange={(v)=>setField('vc',v)} />
            <InputField label="Número de cortes Z" value={input.z} onChange={(v)=>setField('z',v)} />
            <InputField label="Avanço vf (mm/min)" value={input.vf} onChange={(v)=>setField('vf',v)} />
            <InputField label="fz (mm/dente)" value={input.fz} onChange={(v)=>setField('fz',v)} />
            <InputField label="ae (mm)" value={input.ae} onChange={(v)=>setField('ae',v)} />
            <InputField label="ap (mm)" value={input.ap} onChange={(v)=>setField('ap',v)} />
          </div>

          <button onClick={reset} className="mt-4 w-full rounded-2xl bg-sky-600 p-3 font-bold text-white shadow-lg shadow-sky-900/40 hover:bg-sky-500">Limpar campos</button>
        </section>

        <section className="space-y-4">
          <div className="rounded-3xl border border-zinc-700/80 bg-zinc-950/75 p-5 shadow-2xl shadow-black/40">
            <div className="mb-4 flex items-center justify-between">
              <h2 className="text-lg font-bold text-sky-300">Status força do corte</h2>
              <span className={statusClass(output.esforco)}>{statusText(output.esforco)}</span>
            </div>
            <div className="text-center">
              <div className="text-6xl font-black tracking-tight text-white">{formatNumber(output.esforco, 1)}%</div>
              <p className="mt-1 text-sm text-zinc-400">Quanto maior a porcentagem, maior o risco da condição de corte.</p>
            </div>
            <div className="mt-5 h-6 overflow-hidden rounded-full bg-zinc-800 ring-1 ring-zinc-700">
              <div className="h-full rounded-full transition-all duration-500" style={{ width: `${Math.min(100, Math.max(0, output.esforco))}%`, background: 'linear-gradient(90deg, #22c55e 0%, #84cc16 35%, #facc15 65%, #f97316 82%, #ef4444 100%)' }} />
            </div>
          </div>

          <div className="grid grid-cols-2 gap-3 md:grid-cols-3">
            <ResultCard title="Deflexão" value={`${formatNumber(output.deflexao, 5)} mm`} />
            <ResultCard title="Deflexão limite" value={`${formatNumber(output.deflexaoLimite, 5)} mm`} />
            <ResultCard title="F corte" value={`${formatNumber(output.forcorte, 1)} N`} />
            <ResultCard title="F corte limite" value={`${formatNumber(output.forcorteLimite, 1)} N`} />
            <ResultCard title="L/D" value={formatNumber(output.ld, 2)} />
            <ResultCard title="Torque" value={`${formatNumber(output.torque, 3)} N·m`} />
          </div>

          <div className="rounded-3xl border border-zinc-700 bg-zinc-950/70 p-4 text-sm text-zinc-300">
            <h3 className="mb-2 font-bold text-sky-300">Referência interna usada</h3>
            <div className="grid gap-2 sm:grid-cols-3">
              <Info label="fz real" value={formatNumber(output.fzReal, 5)} />
              <Info label="hm" value={formatNumber(output.hm, 5)} />
              <Info label="Tabela" value={input.modo === 'Topo' ? 'ap / L-D' : 'ae / lateral'} />
            </div>
          </div>
        </section>
      </main>
    </div>
  )
}

function LoginScreen({ login, setLogin, onEnter }) {
  const canEnter = login.user.trim().length > 0 && login.pass.trim().length > 0
  return (
    <div className="flex min-h-screen items-center justify-center bg-[radial-gradient(circle_at_top,#075985_0%,#09090b_42%,#030303_100%)] p-4 text-white">
      <div className="w-full max-w-md rounded-[2rem] border border-sky-400/30 bg-zinc-950/85 p-7 shadow-2xl shadow-black/60 backdrop-blur-xl">
        <div className="mb-8 text-center">
          <div className="mx-auto mb-4 flex h-24 w-24 items-center justify-center rounded-[2rem] bg-sky-500/15 text-5xl font-black text-sky-300 ring-1 ring-sky-300/40">C</div>
          <h1 className="text-4xl font-black tracking-tight">CNC PRO MAX</h1>
          <p className="mt-2 text-sm text-sky-200">Force Calculator</p>
        </div>

        <div className="space-y-4">
          <InputField label="Usuário" value={login.user} onChange={(v)=>setLogin({...login, user:v})} />
          <InputField label="Senha" type="password" value={login.pass} onChange={(v)=>setLogin({...login, pass:v})} />
          <button disabled={!canEnter} onClick={onEnter} className="w-full rounded-2xl bg-sky-600 p-3 font-bold text-white shadow-lg shadow-sky-900/50 disabled:cursor-not-allowed disabled:bg-zinc-700">Entrar no app</button>
        </div>
      </div>
    </div>
  )
}

function InputField({ label, value, onChange, type = 'text' }) {
  return (
    <label className="block">
      <span className="mb-1 block text-xs font-semibold uppercase tracking-wide text-zinc-400">{label}</span>
      <input type={type} className="w-full rounded-2xl border border-zinc-700 bg-zinc-900 px-3 py-3 text-white outline-none transition focus:border-sky-400 focus:ring-2 focus:ring-sky-500/20" value={value} onChange={e=>onChange(e.target.value)} />
    </label>
  )
}

function SelectField({ label, value, onChange, options, allowBlank = false }) {
  return (
    <label className="block">
      <span className="mb-1 block text-xs font-semibold uppercase tracking-wide text-zinc-400">{label}</span>
      <select className="w-full rounded-2xl border border-zinc-700 bg-zinc-900 px-3 py-3 text-white outline-none transition focus:border-sky-400 focus:ring-2 focus:ring-sky-500/20" value={value} onChange={e=>onChange(e.target.value)}>
        {allowBlank && <option value="">Selecione</option>}
        {options.map(o=><option key={o} value={o}>{o}</option>)}
      </select>
    </label>
  )
}

function ResultCard({ title, value }) {
  return (
    <div className="rounded-3xl border border-zinc-700 bg-zinc-950/75 p-4 shadow-xl shadow-black/20">
      <div className="text-xs font-semibold uppercase tracking-wide text-sky-300">{title}</div>
      <div className="mt-2 text-xl font-black text-white">{value}</div>
    </div>
  )
}

function Info({ label, value }) {
  return (
    <div className="rounded-2xl bg-zinc-900 p-3">
      <div className="text-xs text-zinc-500">{label}</div>
      <div className="font-bold text-white">{value}</div>
    </div>
  )
}

function statusText(value) {
  if (value < 50) return 'LEVE'
  if (value < 80) return 'MODERADO'
  if (value < 100) return 'AGRESSIVO'
  return 'RISCO'
}

function statusClass(value) {
  if (value < 50) return 'rounded-full border border-green-400/40 bg-green-500/10 px-3 py-1 text-xs font-bold text-green-300'
  if (value < 80) return 'rounded-full border border-yellow-400/40 bg-yellow-500/10 px-3 py-1 text-xs font-bold text-yellow-300'
  if (value < 100) return 'rounded-full border border-orange-400/40 bg-orange-500/10 px-3 py-1 text-xs font-bold text-orange-300'
  return 'rounded-full border border-red-400/40 bg-red-500/10 px-3 py-1 text-xs font-bold text-red-300'
}
  { name: 'Inox 316', kc: 2600, mc: 0.22, fsAdaptive: 4.4 / 3, fsRough: 4.4 },
  { name: 'Titânio Ti6Al4V', kc: 3000, mc: 0.2, fsAdaptive: 4.61 / 3, fsRough: 4.61 },
  { name: 'Nylon', kc: 150, mc: 0.3, fsAdaptive: 0.23 / 3, fsRough: 0.23 },
  { name: 'POM (Delrin)', kc: 200, mc: 0.3, fsAdaptive: 0.307 / 3, fsRough: 0.307 },
  { name: 'PTFE', kc: 120, mc: 0.3, fsAdaptive: 0.184 / 3, fsRough: 0.184 },
  { name: 'Acrílico', kc: 180, mc: 0.3, fsAdaptive: 0.276 / 3, fsRough: 0.276 },
  { name: 'MDF', kc: 80, mc: 0.35, fsAdaptive: 0.123 / 3, fsRough: 0.123 },
  { name: 'Madeira dura', kc: 120, mc: 0.35, fsAdaptive: 0.184 / 3, fsRough: 0.184 },
];

const fsRupturaTable = Object.fromEntries(
  Array.from({ length: 25 }, (_, i) => [
    i + 1,
    { fsAdaptive: 1, fsRough: 1, fsAl7475Adaptive: 0.9, fsAl7475Rough: 1.1 },
  ])
);

const diameters = Array.from({ length: 25 }, (_, i) => i + 1);

const defaultForm = {
  eficienciaModo: 'padrao',
  eficiencia: 100,
  projeto: 'Novo projeto',
  modo: 'adaptive',
  material: 'Inox 316',
  diametro: 12,
  balanco: 36,
  rpm: 2653,
  vc: 100,
  vf: 1380,
  fz: 0.13,
  ae: 1.2,
  ap: 18,
  z: 4,
  elasticidade: 600000,
  trs: 250,
  lastEdited: 'rpm',
  lastFeedEdited: 'vf',
};

const defaultNewUser = {
  username: '',
  password: '',
  role: 'usar',
};

function formatNumber(value, digits = 3) {
  if (!Number.isFinite(value) || value === null || value === '') return '-';
  return new Intl.NumberFormat('pt-BR', {
    minimumFractionDigits: 0,
    maximumFractionDigits: digits,
  }).format(value);
}

function usePersistentState(key, initialValue) {
  const [state, setState] = useState(() => {
    try {
      const raw = localStorage.getItem(key);
      return raw ? JSON.parse(raw) : initialValue;
    } catch {
      return initialValue;
    }
  });

  useEffect(() => {
    try {
      localStorage.setItem(key, JSON.stringify(state));
    } catch {}
  }, [key, state]);

  return [state, setState];
}

function getNivelEsforco(esforco) {
  if (!Number.isFinite(esforco) || esforco <= 0) return '-';
  if (esforco < 50) return 'LEVE';
  if (esforco < 80) return 'MODERADO';
  if (esforco < 100) return 'AGRESSIVO';
  return 'RISCO DE QUEBRA';
}

export default function CalculadoraForcaCorteApp() {
  const [screen, setScreen] = useState('home');
  const [form, setForm] = usePersistentState('cnc-app-form', defaultForm);
  const [users, setUsers] = usePersistentState('cnc-app-users', DEFAULT_USERS);
  const [sessionUser, setSessionUser] = usePersistentState('cnc-app-auth-user', null);
  const [accessLogs, setAccessLogs] = usePersistentState('cnc-app-access-logs', []);
  const [usernameInput, setUsernameInput] = useState('');
  const [passwordInput, setPasswordInput] = useState('');
  const [loginError, setLoginError] = useState('');
  const [newUser, setNewUser] = useState(defaultNewUser);

  useEffect(() => {
    setUsers((prev) => {
      const list = Array.isArray(prev) && prev.length > 0 ? [...prev] : [...DEFAULT_USERS];
      const idx = list.findIndex((u) => u.username === 'admin');
      const adminUser = { username: 'admin', password: '@2391375()', role: 'admin', canModify: true, active: true };
      if (idx >= 0) {
        const current = list[idx];
        if (
          current.password === adminUser.password &&
          current.role === adminUser.role &&
          current.canModify === adminUser.canModify &&
          current.active === adminUser.active
        ) {
          return prev;
        }
        list[idx] = { ...current, ...adminUser };
        return list;
      }
      return [adminUser, ...list];
    });
  }, [setUsers]);

  const selectedMaterial = useMemo(
    () => materials.find((m) => m.name === form.material) ?? materials[0],
    [form.material]
  );

  const isAdmin = sessionUser?.role === 'admin';
  const canModify = Boolean(sessionUser?.canModify);

  const updateField = (field, value) => {
    if (!canModify) return;
    setForm((prev) => ({ ...prev, [field]: value }));
  };

  const addAccessLog = (username, role, event) => {
    const entry = {
      id: Date.now() + Math.random(),
      username,
      role,
      event,
      createdAt: new Date().toLocaleString('pt-BR'),
    };
    setAccessLogs((prev) => [entry, ...prev].slice(0, 200));
  };

  useEffect(() => {
    if (form.eficienciaModo === 'padrao' && form.eficiencia !== 100) {
      setForm((prev) => ({ ...prev, eficiencia: 100 }));
    }
  }, [form.eficienciaModo, form.eficiencia, setForm]);

  useEffect(() => {
    const diam = Number(form.diametro || 0);
    if (diam <= 0 || !canModify) return;

    if ((form.lastEdited || 'rpm') === 'rpm') {
      const nextVc = (Math.PI * diam * Number(form.rpm || 0)) / 1000;
      setForm((prev) => {
        const rounded = Number(nextVc.toFixed(3));
        return Math.abs(Number(prev.vc || 0) - rounded) < 0.001 ? prev : { ...prev, vc: rounded };
      });
    } else {
      const nextRpm = (1000 * Number(form.vc || 0)) / (Math.PI * diam);
      setForm((prev) => {
        const rounded = Number(nextRpm.toFixed(0));
        return Math.abs(Number(prev.rpm || 0) - rounded) < 1 ? prev : { ...prev, rpm: rounded };
      });
    }
  }, [form.rpm, form.vc, form.diametro, form.lastEdited, canModify, setForm]);

  useEffect(() => {
    const rpmRaw = form.rpm;
    const zRaw = form.z;
    const vfRaw = form.vf;
    const fzRaw = form.fz;
    const rpm = Number(rpmRaw);
    const z = Number(zRaw);

    const rpmEmpty = rpmRaw === '' || rpmRaw === null || rpmRaw === undefined;
    const zEmpty = zRaw === '' || zRaw === null || zRaw === undefined;
    const vfEmpty = vfRaw === '' || vfRaw === null || vfRaw === undefined;
    const fzEmpty = fzRaw === '' || fzRaw === null || fzRaw === undefined;

    if (!canModify || rpmEmpty || zEmpty || rpm <= 0 || z <= 0) return;

    if ((form.lastFeedEdited || 'vf') === 'vf') {
      if (vfEmpty) {
        setForm((prev) => (prev.fz === '' ? prev : { ...prev, fz: '' }));
        return;
      }
      const nextFz = Number(vfRaw) / (rpm * z);
      setForm((prev) => {
        const rounded = Number(nextFz.toFixed(4));
        return Math.abs(Number(prev.fz || 0) - rounded) < 0.0001 ? prev : { ...prev, fz: rounded };
      });
    } else {
      if (fzEmpty) {
        setForm((prev) => (prev.vf === '' ? prev : { ...prev, vf: '' }));
        return;
      }
      const nextVf = Number(fzRaw) * rpm * z;
      setForm((prev) => {
        const rounded = Number(nextVf.toFixed(0));
        return Math.abs(Number(prev.vf || 0) - rounded) < 1 ? prev : { ...prev, vf: rounded };
      });
    }
  }, [form.rpm, form.z, form.vf, form.fz, form.lastFeedEdited, canModify, setForm]);

  const resultados = useMemo(() => {
    const eficienciaPercentual = form.eficienciaModo === 'padrao' ? 100 : Number(form.eficiencia || 0);
    const eficienciaFactor = eficienciaPercentual > 0 ? 100 / eficienciaPercentual : 1;
    const kc = selectedMaterial.kc;
    const mc = selectedMaterial.mc;
    const diametro = Number(form.diametro || 0);
    const balanco = Number(form.balanco || 0);
    const ae = Number(form.ae || 0);
    const ap = Number(form.ap || 0);
    const rpm = Number(form.rpm || 0);
    const z = Number(form.z || 0);
    const vf = Number(form.vf || 0);
    const fz = rpm > 0 && z > 0 ? vf / (rpm * z) : 0;
    const elasticidade = Number(form.elasticidade || 0);
    const trs = Number(form.trs || 0);

    const hm = diametro > 0 && ae > 0 ? fz * Math.sqrt(ae / diametro) : 0;

    const adaptiveFactor = (() => {
      if (form.modo !== 'adaptive' || diametro <= 0 || z <= 0) return 1;
      const inner = 1 - Math.min(2, (3 * ae) / diametro);
      const clamped = Math.max(-1, Math.min(1, inner));
      const angleDeg = (2 * Math.acos(clamped) * 180) / Math.PI;
      return Math.max(1, z * (angleDeg / 360));
    })();

    const fcorteBase = hm > 0
      ? form.modo === 'rough'
        ? kc * ap * Math.pow(hm, 1 - mc)
        : kc * ap * Math.pow(hm, 1 - mc) * adaptiveFactor
      : 0;

    const fcorte = fcorteBase * eficienciaFactor;
    const ld = diametro > 0 ? balanco / diametro : 0;
    const inercia = diametro > 0 ? (Math.PI * Math.pow(diametro, 4)) / 64 : 0;
    const deflexaoBase = elasticidade > 0 && inercia > 0
      ? (fcorte * Math.pow(balanco, 3)) / (3 * elasticidade * inercia)
      : 0;

    const deflexao = form.modo === 'adaptive'
      ? deflexaoBase / 3
      : form.modo === 'rough'
        ? deflexaoBase * 1.6288478
        : deflexaoBase;

    const fsRow = fsRupturaTable[diametro] ?? {
      fsAdaptive: 1,
      fsRough: 1,
      fsAl7475Adaptive: 0.9,
      fsAl7475Rough: 1.1,
    };

    const materialFs = selectedMaterial.name === 'Alumínio 7475'
      ? form.modo === 'adaptive'
        ? fsRow.fsAl7475Adaptive
        : fsRow.fsAl7475Rough
      : form.modo === 'adaptive'
        ? selectedMaterial.fsAdaptive
        : selectedMaterial.fsRough;

    const diameterFs = selectedMaterial.name === 'Alumínio 7475'
      ? 1
      : form.modo === 'adaptive'
        ? fsRow.fsAdaptive
        : fsRow.fsRough;

    const fsRuptura = Math.max((materialFs || 1) * (diameterFs || 1), 0.0001);
    const baseRuptura = balanco > 0
      ? ((trs / fsRuptura) * Math.PI * Math.pow(diametro, 3)) / (32 * balanco)
      : 0;

    const penalizacaoBalanco = diametro > 0
      ? balanco <= 5 * diametro
        ? 1
        : Math.pow(0.96, Math.max(0, balanco - (diametro / 2) * diametro))
      : 0;

    const limiteRuptura = form.modo === 'rough'
      ? baseRuptura * penalizacaoBalanco
      : baseRuptura * penalizacaoBalanco * 4;

    const indiceRuptura = limiteRuptura > 0 ? fcorte / limiteRuptura : 0;
    const deflexaoLimiteBase = indiceRuptura > 0 ? deflexaoBase / indiceRuptura : 0;

    const deflexaoLimite = form.modo === 'adaptive'
      ? deflexaoLimiteBase / 3
      : form.modo === 'rough'
        ? deflexaoLimiteBase * 1.6288478
        : deflexaoLimiteBase;

    const esforco = indiceRuptura * 100;

    return {
      kc,
      ld,
      deflexao,
      deflexaoLimite,
      esforco,
      nivelEsforco: getNivelEsforco(esforco),
    };
  }, [form, selectedMaterial]);

  const resetForm = () => {
    if (!canModify) return;
    setForm((prev) => ({
      ...prev,
      balanco: '',
      rpm: '',
      vc: '',
      vf: '',
      fz: '',
      ae: '',
      ap: '',
      z: '',
      lastEdited: 'rpm',
      lastFeedEdited: 'vf',
    }));
  };

  const handleLogin = () => {
    const matchedUser = users.find(
      (user) => user.active && user.username === usernameInput.trim() && user.password === passwordInput
    );

    if (matchedUser) {
      const session = {
        username: matchedUser.username,
        role: matchedUser.role,
        canModify: matchedUser.canModify,
      };
      setSessionUser(session);
      setLoginError('');
      addAccessLog(matchedUser.username, matchedUser.role, 'login');
      setUsernameInput('');
      setPasswordInput('');
      setScreen('home');
      return;
    }

    addAccessLog(usernameInput || 'desconhecido', 'sem acesso', 'falha_login');
    setLoginError('Usuário ou senha incorretos');
  };

  const handleLogout = () => {
    if (sessionUser) addAccessLog(sessionUser.username, sessionUser.role, 'logout');
    setSessionUser(null);
    setScreen('home');
  };

  const handleCreateUser = () => {
    if (!isAdmin) return;
    const username = newUser.username.trim();
    const password = newUser.password.trim();
    if (!username || !password) return;
    if (users.some((u) => u.username.toLowerCase() === username.toLowerCase())) return;

    const role = newUser.role;
    const created = {
      username,
      password,
      role,
      canModify: role === 'admin',
      active: true,
    };

    setUsers((prev) => [created, ...prev]);
    addAccessLog(sessionUser.username, sessionUser.role, `criou_usuario:${username}`);
    setNewUser(defaultNewUser);
  };

  const toggleUserActive = (username) => {
    if (!isAdmin) return;
    setUsers((prev) => prev.map((u) => (u.username === username ? { ...u, active: !u.active } : u)));
    addAccessLog(sessionUser.username, sessionUser.role, `alterou_status:${username}`);
  };

  const deleteUser = (username) => {
    if (!isAdmin || username === sessionUser?.username) return;
    setUsers((prev) => prev.filter((u) => u.username !== username));
    addAccessLog(sessionUser.username, sessionUser.role, `removeu_usuario:${username}`);
  };

  const resetUserPassword = (username) => {
    if (!isAdmin) return;
    const novaSenha = prompt(`Nova senha para ${username}`);
    if (!novaSenha) return;
    setUsers((prev) => prev.map((u) => (u.username === username ? { ...u, password: novaSenha } : u)));
    addAccessLog(sessionUser.username, sessionUser.role, `alterou_senha:${username}`);
  };

  if (!sessionUser) {
    return (
      <div className="min-h-screen bg-blue-950 text-white">
        <div className="mx-auto flex min-h-screen w-full max-w-md items-center justify-center border-x border-blue-800 bg-gradient-to-b from-blue-950 via-slate-950 to-blue-950 px-4 shadow-2xl">
          <Card className="w-full rounded-3xl border-cyan-900/30 bg-gradient-to-br from-blue-900/80 to-slate-900 shadow-2xl">
            <CardContent className="p-6">
              <div className="mb-4 flex h-14 w-14 items-center justify-center rounded-2xl border border-cyan-400/20 bg-cyan-400/10 shadow-inner">
                <Lock className="h-7 w-7 text-blue-100" />
              </div>
              <h1 className="text-2xl font-bold text-white">CNC APP</h1>
              <p className="mt-2 text-slate-300">Acesso restrito por usuário e senha</p>
              <div className="mt-5 space-y-3">
                <div className="space-y-2">
                  <Label className="text-cyan-100">Usuário</Label>
                  <Input
                    type="text"
                    value={usernameInput}
                    onChange={(e) => setUsernameInput(e.target.value)}
                    className="rounded-2xl border-cyan-900/40 bg-slate-950/80 text-white"
                  />
                </div>
                <div className="space-y-2">
                  <Label className="text-cyan-100">Senha</Label>
                  <Input
                    type="password"
                    value={passwordInput}
                    onChange={(e) => setPasswordInput(e.target.value)}
                    onKeyDown={(e) => {
                      if (e.key === 'Enter') handleLogin();
                    }}
                    className="rounded-2xl border-cyan-900/40 bg-slate-950/80 text-white"
                  />
                </div>
                {loginError ? <div className="text-sm text-red-300">{loginError}</div> : null}
                <Button className="h-12 w-full rounded-2xl bg-cyan-500 font-semibold text-slate-950 shadow-lg hover:bg-cyan-400" onClick={handleLogin}>
                  Entrar
                </Button>
              </div>
            </CardContent>
          </Card>
        </div>
      </div>
    );
  }

  return (
    <div className="min-h-screen bg-blue-950 text-white">
      <div className="mx-auto flex min-h-screen w-full max-w-md flex-col border-x border-blue-800 bg-gradient-to-b from-blue-950 via-slate-950 to-blue-950 shadow-2xl">
        <header className="sticky top-0 z-20 border-b border-cyan-900/40 bg-blue-950/90 px-4 py-4 shadow-lg backdrop-blur">
          <div className="flex items-center justify-between gap-3">
            <h1 className="text-lg font-semibold text-white">CNC APP</h1>
            <div className="flex items-center gap-2">
              <Badge className="border border-cyan-500/20 bg-cyan-400/10 text-cyan-200">{sessionUser.username} · {sessionUser.role}</Badge>
              <Button
                variant="outline"
                className="h-9 rounded-2xl border-cyan-700/50 bg-blue-950/30 px-3 text-white hover:bg-blue-900/50"
                onClick={handleLogout}
              >
                Sair
              </Button>
            </div>
          </div>
        </header>

        <main className="flex-1 space-y-4 px-4 py-4 pb-24">
          {screen === 'home' && (
            <div className="space-y-4">
              <Card className="rounded-3xl border-cyan-900/30 bg-gradient-to-br from-blue-900/80 to-slate-900 shadow-2xl">
                <CardContent className="p-6">
                  <div className="mb-4 flex h-14 w-14 items-center justify-center rounded-2xl border border-cyan-400/20 bg-cyan-400/10 shadow-inner">
                    <Smartphone className="h-7 w-7 text-blue-100" />
                  </div>
                  <h2 className="text-2xl font-bold text-white">App pronto para celular</h2>
                  <p className="mt-2 leading-relaxed text-slate-300">Formulas do CNC APP com rpm/vc e avanço/fz sincronizados</p>
                  <div className="mt-5 grid grid-cols-2 gap-3">
                    <Button className="h-12 rounded-2xl bg-cyan-500 font-semibold text-slate-950 shadow-lg hover:bg-cyan-400" onClick={() => setScreen('calc')}>
                      Abrir cálculo
                    </Button>
                    <Button
                      variant="outline"
                      className="h-12 rounded-2xl border-cyan-700/50 bg-blue-950/30 text-white hover:bg-blue-900/50"
                      onClick={() => setScreen('logs')}
                    >
                      Logs
                    </Button>
                  </div>
                </CardContent>
              </Card>
            </div>
          )}

          {screen === 'calc' && (
            <div className="space-y-4">
              <Card className="rounded-3xl border-cyan-900/30 bg-gradient-to-br from-blue-900/75 to-slate-950 shadow-xl">
