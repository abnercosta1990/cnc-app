const fsRupturaTable = Object.fromEntries(
  Array.from({ length: 25 }, (_, i) => [
    i + 1,
    { fsAdaptive: 1, fsRough: 1, fsAl7475Adaptive: 0.9, fsAl7475Rough: 1.1 },
  ])
);

const diameters = Array.from({ length: 25 }, (_, i) => i + 1);

const defaultForm = {
  eficienciaModo: 'padrao',
  eficiencia: 100,
  projeto: 'Novo projeto',
  modo: 'adaptive',
  material: 'Inox 316',
  diametro: 12,
  balanco: 36,
  rpm: 2653,
  vc: 100,
  vf: 1380,
  fz: 0.13,
  ae: 1.2,
  ap: 18,
  z: 4,
  elasticidade: 600000,
  trs: 250,
  lastEdited: 'rpm',
  lastFeedEdited: 'vf',
};

const defaultNewUser = {
  username: '',
  password: '',
  role: 'usar',
};

function formatNumber(value, digits = 3) {
  if (!Number.isFinite(value) || value === null || value === '') return '-';
  return new Intl.NumberFormat('pt-BR', {
    minimumFractionDigits: 0,
    maximumFractionDigits: digits,
  }).format(value);
}

function usePersistentState(key, initialValue) {
  const [state, setState] = useState(() => {
    try {
      const raw = localStorage.getItem(key);
      return raw ? JSON.parse(raw) : initialValue;
    } catch {
      return initialValue;
    }
  });

  useEffect(() => {
    try {
      localStorage.setItem(key, JSON.stringify(state));
    } catch {}
  }, [key, state]);

  return [state, setState];
}

function getNivelEsforco(esforco) {
  if (!Number.isFinite(esforco) || esforco <= 0) return '-';
  if (esforco < 50) return 'LEVE';
  if (esforco < 80) return 'MODERADO';
  if (esforco < 100) return 'AGRESSIVO';
  return 'RISCO DE QUEBRA';
}

export default function CalculadoraForcaCorteApp() {
  const [screen, setScreen] = useState('home');
  const [form, setForm] = usePersistentState('cnc-app-form', defaultForm);
  const [users, setUsers] = usePersistentState('cnc-app-users', DEFAULT_USERS);
  const [sessionUser, setSessionUser] = usePersistentState('cnc-app-auth-user', null);
  const [accessLogs, setAccessLogs] = usePersistentState('cnc-app-access-logs', []);
  const [usernameInput, setUsernameInput] = useState('');
  const [passwordInput, setPasswordInput] = useState('');
  const [loginError, setLoginError] = useState('');
  const [newUser, setNewUser] = useState(defaultNewUser);

  useEffect(() => {
    setUsers((prev) => {
      const list = Array.isArray(prev) && prev.length > 0 ? [...prev] : [...DEFAULT_USERS];
      const idx = list.findIndex((u) => u.username === 'admin');
      const adminUser = { username: 'admin', password: '@2391375()', role: 'admin', canModify: true, active: true };
      if (idx >= 0) {
        const current = list[idx];
        if (
          current.password === adminUser.password &&
          current.role === adminUser.role &&
          current.canModify === adminUser.canModify &&
          current.active === adminUser.active
        ) {
          return prev;
        }
        list[idx] = { ...current, ...adminUser };
        return list;
      }
      return [adminUser, ...list];
    });
  }, [setUsers]);

  const selectedMaterial = useMemo(
    () => materials.find((m) => m.name === form.material) ?? materials[0],
    [form.material]
  );

  const isAdmin = sessionUser?.role === 'admin';
  const canModify = Boolean(sessionUser?.canModify);

  const updateField = (field, value) => {
    if (!canModify) return;
    setForm((prev) => ({ ...prev, [field]: value }));
  };

  const addAccessLog = (username, role, event) => {
    const entry = {
      id: Date.now() + Math.random(),
      username,
      role,
      event,
      createdAt: new Date().toLocaleString('pt-BR'),
    };
    setAccessLogs((prev) => [entry, ...prev].slice(0, 200));
  };

  useEffect(() => {
    if (form.eficienciaModo === 'padrao' && form.eficiencia !== 100) {
      setForm((prev) => ({ ...prev, eficiencia: 100 }));
    }
  }, [form.eficienciaModo, form.eficiencia, setForm]);

  useEffect(() => {
    const diam = Number(form.diametro || 0);
    if (diam <= 0 || !canModify) return;

    if ((form.lastEdited || 'rpm') === 'rpm') {
      const nextVc = (Math.PI * diam * Number(form.rpm || 0)) / 1000;
      setForm((prev) => {
        const rounded = Number(nextVc.toFixed(3));
        return Math.abs(Number(prev.vc || 0) - rounded) < 0.001 ? prev : { ...prev, vc: rounded };
      });
    } else {
      const nextRpm = (1000 * Number(form.vc || 0)) / (Math.PI * diam);
      setForm((prev) => {
        const rounded = Number(nextRpm.toFixed(0));
        return Math.abs(Number(prev.rpm || 0) - rounded) < 1 ? prev : { ...prev, rpm: rounded };
      });
    }
  }, [form.rpm, form.vc, form.diametro, form.lastEdited, canModify, setForm]);

  useEffect(() => {
    const rpmRaw = form.rpm;
    const zRaw = form.z;
    const vfRaw = form.vf;
    const fzRaw = form.fz;
    const rpm = Number(rpmRaw);
    const z = Number(zRaw);

    const rpmEmpty = rpmRaw === '' || rpmRaw === null || rpmRaw === undefined;
    const zEmpty = zRaw === '' || zRaw === null || zRaw === undefined;
    const vfEmpty = vfRaw === '' || vfRaw === null || vfRaw === undefined;
    const fzEmpty = fzRaw === '' || fzRaw === null || fzRaw === undefined;

    if (!canModify || rpmEmpty || zEmpty || rpm <= 0 || z <= 0) return;

    if ((form.lastFeedEdited || 'vf') === 'vf') {
      if (vfEmpty) {
        setForm((prev) => (prev.fz === '' ? prev : { ...prev, fz: '' }));
        return;
      }
      const nextFz = Number(vfRaw) / (rpm * z);
      setForm((prev) => {
        const rounded = Number(nextFz.toFixed(4));
        return Math.abs(Number(prev.fz || 0) - rounded) < 0.0001 ? prev : { ...prev, fz: rounded };
      });
    } else {
      if (fzEmpty) {
        setForm((prev) => (prev.vf === '' ? prev : { ...prev, vf: '' }));
        return;
      }
      const nextVf = Number(fzRaw) * rpm * z;
      setForm((prev) => {
        const rounded = Number(nextVf.toFixed(0));
        return Math.abs(Number(prev.vf || 0) - rounded) < 1 ? prev : { ...prev, vf: rounded };
      });
    }
  }, [form.rpm, form.z, form.vf, form.fz, form.lastFeedEdited, canModify, setForm]);

  const resultados = useMemo(() => {
    const eficienciaPercentual = form.eficienciaModo === 'padrao' ? 100 : Number(form.eficiencia || 0);
    const eficienciaFactor = eficienciaPercentual > 0 ? 100 / eficienciaPercentual : 1;
    const kc = selectedMaterial.kc;
    const mc = selectedMaterial.mc;
    const diametro = Number(form.diametro || 0);
    const balanco = Number(form.balanco || 0);
    const ae = Number(form.ae || 0);
    const ap = Number(form.ap || 0);
    const rpm = Number(form.rpm || 0);
    const z = Number(form.z || 0);
    const vf = Number(form.vf || 0);
    const fz = rpm > 0 && z > 0 ? vf / (rpm * z) : 0;
    const elasticidade = Number(form.elasticidade || 0);
    const trs = Number(form.trs || 0);

    const hm = diametro > 0 && ae > 0 ? fz * Math.sqrt(ae / diametro) : 0;

    const adaptiveFactor = (() => {
      if (form.modo !== 'adaptive' || diametro <= 0 || z <= 0) return 1;
      const inner = 1 - Math.min(2, (3 * ae) / diametro);
      const clamped = Math.max(-1, Math.min(1, inner));
      const angleDeg = (2 * Math.acos(clamped) * 180) / Math.PI;
      return Math.max(1, z * (angleDeg / 360));
    })();

    const fcorteBase = hm > 0
      ? form.modo === 'rough'
        ? kc * ap * Math.pow(hm, 1 - mc)
        : kc * ap * Math.pow(hm, 1 - mc) * adaptiveFactor
      : 0;

    const fcorte = fcorteBase * eficienciaFactor;
    const ld = diametro > 0 ? balanco / diametro : 0;
    const inercia = diametro > 0 ? (Math.PI * Math.pow(diametro, 4)) / 64 : 0;
    const deflexaoBase = elasticidade > 0 && inercia > 0
      ? (fcorte * Math.pow(balanco, 3)) / (3 * elasticidade * inercia)
      : 0;

    const deflexao = form.modo === 'adaptive'
      ? deflexaoBase / 3
      : form.modo === 'rough'
        ? deflexaoBase * 1.6288478
        : deflexaoBase;

    const fsRow = fsRupturaTable[diametro] ?? {
      fsAdaptive: 1,
      fsRough: 1,
      fsAl7475Adaptive: 0.9,
      fsAl7475Rough: 1.1,
    };

    const materialFs = selectedMaterial.name === 'Alumínio 7475'
      ? form.modo === 'adaptive'
        ? fsRow.fsAl7475Adaptive
        : fsRow.fsAl7475Rough
      : form.modo === 'adaptive'
        ? selectedMaterial.fsAdaptive
        : selectedMaterial.fsRough;

    const diameterFs = selectedMaterial.name === 'Alumínio 7475'
      ? 1
      : form.modo === 'adaptive'
        ? fsRow.fsAdaptive
        : fsRow.fsRough;

    const fsRuptura = Math.max((materialFs || 1) * (diameterFs || 1), 0.0001);
    const baseRuptura = balanco > 0
      ? ((trs / fsRuptura) * Math.PI * Math.pow(diametro, 3)) / (32 * balanco)
      : 0;

    const penalizacaoBalanco = diametro > 0
      ? balanco <= 5 * diametro
        ? 1
        : Math.pow(0.96, Math.max(0, balanco - (diametro / 2) * diametro))
      : 0;

    const limiteRuptura = form.modo === 'rough'
      ? baseRuptura * penalizacaoBalanco
      : baseRuptura * penalizacaoBalanco * 4;

    const indiceRuptura = limiteRuptura > 0 ? fcorte / limiteRuptura : 0;
    const deflexaoLimiteBase = indiceRuptura > 0 ? deflexaoBase / indiceRuptura : 0;

    const deflexaoLimite = form.modo === 'adaptive'
      ? deflexaoLimiteBase / 3
      : form.modo === 'rough'
        ? deflexaoLimiteBase * 1.6288478
        : deflexaoLimiteBase;

    const esforco = indiceRuptura * 100;

    return {
      kc,
      ld,
      deflexao,
      deflexaoLimite,
      esforco,
      nivelEsforco: getNivelEsforco(esforco),
    };
  }, [form, selectedMaterial]);

  const resetForm = () => {
    if (!canModify) return;
    setForm((prev) => ({
      ...prev,
      balanco: '',
      rpm: '',
      vc: '',
      vf: '',
      fz: '',
      ae: '',
      ap: '',
      z: '',
      lastEdited: 'rpm',
      lastFeedEdited: 'vf',
    }));
  };

  const handleLogin = () => {
    const matchedUser = users.find(
      (user) => user.active && user.username === usernameInput.trim() && user.password === passwordInput
    );

    if (matchedUser) {
      const session = {
        username: matchedUser.username,
        role: matchedUser.role,
        canModify: matchedUser.canModify,
      };
      setSessionUser(session);
      setLoginError('');
      addAccessLog(matchedUser.username, matchedUser.role, 'login');
      setUsernameInput('');
      setPasswordInput('');
      setScreen('home');
      return;
    }

    addAccessLog(usernameInput || 'desconhecido', 'sem acesso', 'falha_login');
    setLoginError('Usuário ou senha incorretos');
  };

  const handleLogout = () => {
    if (sessionUser) addAccessLog(sessionUser.username, sessionUser.role, 'logout');
    setSessionUser(null);
    setScreen('home');
  };

  const handleCreateUser = () => {
    if (!isAdmin) return;
    const username = newUser.username.trim();
    const password = newUser.password.trim();
    if (!username || !password) return;
    if (users.some((u) => u.username.toLowerCase() === username.toLowerCase())) return;

    const role = newUser.role;
    const created = {
      username,
      password,
      role,
      canModify: role === 'admin',
      active: true,
    };

    setUsers((prev) => [created, ...prev]);
    addAccessLog(sessionUser.username, sessionUser.role, `criou_usuario:${username}`);
    setNewUser(defaultNewUser);
  };

  const toggleUserActive = (username) => {
    if (!isAdmin) return;
    setUsers((prev) => prev.map((u) => (u.username === username ? { ...u, active: !u.active } : u)));
    addAccessLog(sessionUser.username, sessionUser.role, `alterou_status:${username}`);
  };

  const deleteUser = (username) => {
    if (!isAdmin || username === sessionUser?.username) return;
    setUsers((prev) => prev.filter((u) => u.username !== username));
    addAccessLog(sessionUser.username, sessionUser.role, `removeu_usuario:${username}`);
  };

  const resetUserPassword = (username) => {
    if (!isAdmin) return;
    const novaSenha = prompt(`Nova senha para ${username}`);
    if (!novaSenha) return;
    setUsers((prev) => prev.map((u) => (u.username === username ? { ...u, password: novaSenha } : u)));
    addAccessLog(sessionUser.username, sessionUser.role, `alterou_senha:${username}`);
  };

  if (!sessionUser) {
    return (
      <div className="min-h-screen bg-blue-950 text-white">
        <div className="mx-auto flex min-h-screen w-full max-w-md items-center justify-center border-x border-blue-800 bg-gradient-to-b from-blue-950 via-slate-950 to-blue-950 px-4 shadow-2xl">
          <Card className="w-full rounded-3xl border-cyan-900/30 bg-gradient-to-br from-blue-900/80 to-slate-900 shadow-2xl">
            <CardContent className="p-6">
              <div className="mb-4 flex h-14 w-14 items-center justify-center rounded-2xl border border-cyan-400/20 bg-cyan-400/10 shadow-inner">
                <Lock className="h-7 w-7 text-blue-100" />
              </div>
              <h1 className="text-2xl font-bold text-white">CNC APP</h1>
              <p className="mt-2 text-slate-300">Acesso restrito por usuário e senha</p>
              <div className="mt-5 space-y-3">
                <div className="space-y-2">
                  <Label className="text-cyan-100">Usuário</Label>
                  <Input
                    type="text"
                    value={usernameInput}
                    onChange={(e) => setUsernameInput(e.target.value)}
                    className="rounded-2xl border-cyan-900/40 bg-slate-950/80 text-white"
                  />
                </div>
                <div className="space-y-2">
                  <Label className="text-cyan-100">Senha</Label>
                  <Input
                    type="password"
                    value={passwordInput}
                    onChange={(e) => setPasswordInput(e.target.value)}
                    onKeyDown={(e) => {
                      if (e.key === 'Enter') handleLogin();
                    }}
                    className="rounded-2xl border-cyan-900/40 bg-slate-950/80 text-white"
                  />
                </div>
                {loginError ? <div className="text-sm text-red-300">{loginError}</div> : null}
                <Button className="h-12 w-full rounded-2xl bg-cyan-500 font-semibold text-slate-950 shadow-lg hover:bg-cyan-400" onClick={handleLogin}>
                  Entrar
                </Button>
              </div>
            </CardContent>
          </Card>
        </div>
      </div>
    );
  }

  return (
    <div className="min-h-screen bg-blue-950 text-white">
      <div className="mx-auto flex min-h-screen w-full max-w-md flex-col border-x border-blue-800 bg-gradient-to-b from-blue-950 via-slate-950 to-blue-950 shadow-2xl">
        <header className="sticky top-0 z-20 border-b border-cyan-900/40 bg-blue-950/90 px-4 py-4 shadow-lg backdrop-blur">
          <div className="flex items-center justify-between gap-3">
            <h1 className="text-lg font-semibold text-white">CNC APP</h1>
            <div className="flex items-center gap-2">
              <Badge className="border border-cyan-500/20 bg-cyan-400/10 text-cyan-200">{sessionUser.username} · {sessionUser.role}</Badge>
              <Button
                variant="outline"
                className="h-9 rounded-2xl border-cyan-700/50 bg-blue-950/30 px-3 text-white hover:bg-blue-900/50"
                onClick={handleLogout}
              >
                Sair
              </Button>
            </div>
          </div>
        </header>

        <main className="flex-1 space-y-4 px-4 py-4 pb-24">
          {screen === 'home' && (
            <div className="space-y-4">
              <Card className="rounded-3xl border-cyan-900/30 bg-gradient-to-br from-blue-900/80 to-slate-900 shadow-2xl">
                <CardContent className="p-6">
                  <div className="mb-4 flex h-14 w-14 items-center justify-center rounded-2xl border border-cyan-400/20 bg-cyan-400/10 shadow-inner">
                    <Smartphone className="h-7 w-7 text-blue-100" />
                  </div>
                  <h2 className="text-2xl font-bold text-white">App pronto para celular</h2>
                  <p className="mt-2 leading-relaxed text-slate-300">Formulas do CNC APP com rpm/vc e avanço/fz sincronizados</p>
                  <div className="mt-5 grid grid-cols-2 gap-3">
                    <Button className="h-12 rounded-2xl bg-cyan-500 font-semibold text-slate-950 shadow-lg hover:bg-cyan-400" onClick={() => setScreen('calc')}>
                      Abrir cálculo
                    </Button>
                    <Button
                      variant="outline"
                      className="h-12 rounded-2xl border-cyan-700/50 bg-blue-950/30 text-white hover:bg-blue-900/50"
                      onClick={() => setScreen('logs')}
                    >
                      Logs
                    </Button>
                  </div>
                </CardContent>
              </Card>
            </div>
          )}

          {screen === 'calc' && (
            <div className="space-y-4">
              <Card className="rounded-3xl border-cyan-900/30 bg-gradient-to-br from-blue-900/75 to-slate-950 shadow-xl">
                <CardHeader className="pb-2">
                  <CardTitle className="text-base text-cyan-100">Entradas de cálculo {canModify ? '' : '(somente uso)'}</CardTitle>
                </CardHeader>
                <CardContent className="grid grid-cols-2 gap-3">
                  <Field label="Eficiência da fresa">
                    <Tabs value={form.eficienciaModo} onValueChange={(v) => canModify && updateField('eficienciaModo', v)}>
                      <TabsList className="grid grid-cols-2 rounded-full border border-cyan-900/40 bg-slate-950/80 p-1">
                        <TabsTrigger value="padrao" className="rounded-full">Padrão</TabsTrigger>
                        <TabsTrigger value="ajustar" className="rounded-full">Ajustar</TabsTrigger>
                      </TabsList>
                    </Tabs>
                    {form.eficienciaModo === 'ajustar' && (
                      <div className="mt-2 flex items-center gap-2">
                        <Input
                          type="number"
                          disabled={!canModify}
                          value={form.eficiencia === '' ? '' : form.eficiencia}
                          onChange={(e) => {
                          if (!canModify) return;
                          const v = e.target.value;
                          updateField('eficiencia', v === '' ? '' : Number(v));
                        }}
                          className="rounded-2xl border-cyan-900/40 bg-slate-950/80 text-white"
                        />
                        <span className="text-cyan-300">%</span>
                      </div>
                    )}
                  </Field>

                  <Field label="Modo de usinagem">
                    <Tabs value={form.modo} onValueChange={(v) => canModify && updateField('modo', v)}>
                      <TabsList className="grid grid-cols-2 rounded-2xl border border-cyan-900/40 bg-slate-950/80">
                        <TabsTrigger value="adaptive" className="rounded-2xl">Adaptive</TabsTrigger>
                        <TabsTrigger value="rough" className="rounded-2xl">Rough</TabsTrigger>
                      </TabsList>
                    </Tabs>
                  </Field>

                  <Field label="Material">
                    <Select value={form.material} onValueChange={(v) => canModify && updateField('material', v)}>
                      <SelectTrigger className="rounded-2xl border-cyan-900/40 bg-slate-950/80 text-white">
                        <SelectValue />
                      </SelectTrigger>
                      <SelectContent>
                        {materials.map((m) => (
                          <SelectItem key={m.name} value={m.name}>{m.name}</SelectItem>
                        ))}
                      </SelectContent>
                    </Select>
                  </Field>

                  <Field label="Diâmetro (mm)">
                    <Select value={String(form.diametro)} onValueChange={(v) => canModify && updateField('diametro', Number(v))}>
                      <SelectTrigger className="rounded-2xl border-cyan-900/40 bg-slate-950/80 text-white">
                        <SelectValue />
                      </SelectTrigger>
                      <SelectContent>
                        {diameters.map((d) => (
                          <SelectItem key={d} value={String(d)}>{d}</SelectItem>
                        ))}
                      </SelectContent>
                    </Select>
                  </Field>

                  <NumberField label="Balanço (mm)" value={form.balanco} onChange={(v) => updateField('balanco', v)} disabled={!canModify} />
                  <NumberField label="RPM" value={form.rpm} onChange={(v) => canModify && setForm((prev) => ({ ...prev, rpm: v, lastEdited: 'rpm' }))} disabled={!canModify} />
                  <NumberField label="Vc (m/min)" value={form.vc} onChange={(v) => canModify && setForm((prev) => ({ ...prev, vc: v, lastEdited: 'vc' }))} step="0.01" disabled={!canModify} />
                  <NumberField label="Avanço (mm/min)" value={form.vf} onChange={(v) => canModify && setForm((prev) => ({ ...prev, vf: v === '' ? '' : v, lastFeedEdited: 'vf' }))} disabled={!canModify} />
                  <NumberField label="Fz (mm/dente)" value={form.fz} onChange={(v) => canModify && setForm((prev) => ({ ...prev, fz: v === '' ? '' : v, lastFeedEdited: 'fz' }))} step="0.001" disabled={!canModify} />
                  <NumberField label="ae (mm)" value={form.ae} onChange={(v) => updateField('ae', v)} step="0.01" disabled={!canModify} />
                  <NumberField label="ap (mm)" value={form.ap} onChange={(v) => updateField('ap', v)} step="0.01" disabled={!canModify} />
                  <NumberField label="Número de cortes" value={form.z} onChange={(v) => updateField('z', v)} disabled={!canModify} />
                </CardContent>
              </Card>

              <Card className="rounded-3xl border-cyan-900/30 bg-gradient-to-br from-blue-900/75 to-slate-950 shadow-xl">
                <CardHeader className="pb-2">
                  <CardTitle className="text-base text-cyan-100">Resultados principais</CardTitle>
                </CardHeader>
                <CardContent className="grid grid-cols-1 gap-4">
                  <ResultTile label="Deflexão" value={formatNumber(resultados.deflexao, 4)} unit="mm" highlight />
                  <ResultTile label="Esforço de corte" value={formatNumber(resultados.esforco, 1)} unit="%" />
                  <ResultTile label="Nível de esforço" value={resultados.nivelEsforco} />
                  <div className="h-3 w-full overflow-hidden rounded-full border border-cyan-900/40 bg-slate-900">
                    <div
                      className="h-full bg-gradient-to-r from-green-400 via-yellow-400 to-red-500"
                      style={{ width: `${Math.min(100, Math.max(0, resultados.esforco || 0))}%` }}
                    />
                  </div>
                  <div className="grid grid-cols-2 gap-3">
                    <MiniInfo label="L/D" value={formatNumber(resultados.ld, 3)} />
                    <MiniInfo label="Deflexão limite" value={formatNumber(resultados.deflexaoLimite, 4)} />
                  </div>
                </CardContent>
              </Card>

              <div className="grid grid-cols-1 gap-3">
                <Button
                  variant="outline"
                  className="h-12 rounded-2xl border-cyan-700/50 bg-blue-950/30 text-white hover:bg-blue-900/50"
                  onClick={resetForm}
                  disabled={!canModify}
                >
                  Limpar
                </Button>
              </div>
            </div>
          )}

          {screen === 'admin' && isAdmin && (
            <div className="space-y-3">
              <Card className="rounded-3xl border-cyan-900/30 bg-gradient-to-br from-blue-900/75 to-slate-950 shadow-xl">
                <CardHeader className="pb-2">
                  <CardTitle className="flex items-center gap-2 text-base text-cyan-100">
                    <Settings className="h-4 w-4" />Painel admin
                  </CardTitle>
                </CardHeader>
                <CardContent className="space-y-4">
                  <div className="grid grid-cols-2 gap-3">
                    <Input
                      placeholder="Usuário"
                      value={newUser.username}
                      onChange={(e) => setNewUser((prev) => ({ ...prev, username: e.target.value }))}
                      className="rounded-2xl border-cyan-900/40 bg-slate-950/80 text-white"
                    />
                    <Input
                      placeholder="Senha"
                      value={newUser.password}
                      onChange={(e) => setNewUser((prev) => ({ ...prev, password: e.target.value }))}
                      className="rounded-2xl border-cyan-900/40 bg-slate-950/80 text-white"
                    />
                    <Select value={newUser.role} onValueChange={(v) => setNewUser((prev) => ({ ...prev, role: v }))}>
                      <SelectTrigger className="rounded-2xl border-cyan-900/40 bg-slate-950/80 text-white">
                        <SelectValue />
                      </SelectTrigger>
                      <SelectContent>
                        <SelectItem value="admin">admin</SelectItem>
                        <SelectItem value="usar">usar</SelectItem>
                      </SelectContent>
                    </Select>
                    <Button className="rounded-2xl bg-cyan-500 font-semibold text-slate-950 hover:bg-cyan-400" onClick={handleCreateUser}>
                      <UserPlus className="mr-2 h-4 w-4" />Novo usuário
                    </Button>
                  </div>
                  <div className="space-y-3">
                    {users.map((user) => (
                      <div key={user.username} className="rounded-2xl border border-cyan-900/30 bg-blue-950/40 p-3">
                        <div className="flex items-center justify-between gap-2">
                          <div>
                            <div className="font-medium text-white">{user.username}</div>
                            <div className="text-sm text-cyan-300/80">{user.role} · {user.active ? 'ativo' : 'bloqueado'}</div>
                          </div>
                          <div className="flex flex-wrap gap-2">
                            <Button
                              variant="outline"
                              className="rounded-2xl border-cyan-700/50 bg-blue-950/30 text-white hover:bg-blue-900/50"
                              onClick={() => toggleUserActive(user.username)}
                            >
                              {user.active ? 'Bloquear' : 'Ativar'}
                            </Button>
                            <Button
                              variant="outline"
                              className="rounded-2xl border-cyan-700/50 bg-blue-950/30 text-white hover:bg-blue-900/50"
                              onClick={() => resetUserPassword(user.username)}
                            >
                              Senha
                            </Button>
                            {user.username !== sessionUser.username && (
                              <Button
                                variant="outline"
                                className="rounded-2xl border-red-700/50 bg-red-950/20 text-red-200 hover:bg-red-900/30"
                                onClick={() => deleteUser(user.username)}
                              >
                                Excluir
                              </Button>
                            )}
                          </div>
                        </div>
                      </div>
                    ))}
                  </div>
                </CardContent>
              </Card>
            </div>
          )}

          {screen === 'logs' && (
            <div className="space-y-3">
              <Card className="rounded-3xl border-cyan-900/30 bg-gradient-to-br from-blue-900/75 to-slate-950 shadow-xl">
                <CardHeader className="pb-2">
                  <CardTitle className="flex items-center gap-2 text-base text-cyan-100">
                    <ClipboardList className="h-4 w-4" />Registro de acesso
                  </CardTitle>
                </CardHeader>
                <CardContent className="space-y-2">
                  {accessLogs.length === 0 ? (
                    <div className="text-sm text-slate-300">Nenhum registro ainda.</div>
                  ) : (
                    accessLogs.map((log) => (
                      <div key={log.id} className="rounded-2xl border border-cyan-900/30 bg-blue-950/40 p-3 text-sm text-white">
                        <div className="font-medium">{log.username} · {log.role}</div>
                        <div className="text-cyan-300/80">{log.event}</div>
                        <div className="text-cyan-300/60">{log.createdAt}</div>
                      </div>
                    ))
                  )}
                </CardContent>
              </Card>
            </div>
          )}
        </main>

        <nav className="fixed bottom-0 left-1/2 w-full max-w-md -translate-x-1/2 border-t border-cyan-900/30 bg-blue-950/90 px-4 py-3 shadow-2xl backdrop-blur">
          <div className={`grid gap-3 ${isAdmin ? 'grid-cols-4' : 'grid-cols-3'}`}>
            <NavButton active={screen === 'home'} icon={<Home className="h-5 w-5" />} label="Início" onClick={() => setScreen('home')} />
            <NavButton active={screen === 'calc'} icon={<Calculator className="h-5 w-5" />} label="Cálculo" onClick={() => setScreen('calc')} />
            <NavButton active={screen === 'logs'} icon={<ClipboardList className="h-5 w-5" />} label="Logs" onClick={() => setScreen('logs')} />
            {isAdmin && <NavButton active={screen === 'admin'} icon={<Settings className="h-5 w-5" />} label="Admin" onClick={() => setScreen('admin')} />}
          </div>
        </nav>
      </div>
    </div>
  );
}

function Field({ label, children }) {
  return (
    <div className="space-y-2">
      <Label className="text-cyan-100">{label}</Label>
      {children}
    </div>
  );
}

function NumberField({ label, value, onChange, step = '1', disabled = false }) {
  return (
    <Field label={label}>
      <Input
        type="number"
        step={step}
        value={value}
        disabled={disabled}
        onChange={(e) => onChange(e.target.value === '' ? '' : Number(e.target.value))}
        className="rounded-2xl border-cyan-900/40 bg-slate-950/80 text-white"
      />
    </Field>
  );
}

function ResultTile({ label, value, unit, highlight = false }) {
  return (
    <div className={`rounded-2xl border p-3 ${highlight ? 'border-cyan-500/30 bg-blue-800/40' : 'border-cyan-900/30 bg-blue-950/60'}`}>
      <div className="text-[11px] uppercase tracking-wide text-cyan-300/70">{label}</div>
      <div className="mt-1 text-lg font-semibold text-white">{value}</div>
      {unit ? <div className="mt-1 text-xs text-cyan-300/60">{unit}</div> : null}
    </div>
  );
}

function MiniInfo({ label, value }) {
  return (
    <div className="rounded-2xl border border-cyan-900/30 bg-blue-950/60 p-3">
      <div className="text-[11px] uppercase tracking-wide text-cyan-300/70">{label}</div>
      <div className="mt-1 text-sm text-white">{value}</div>
    </div>
  );
}

function NavButton({ active, icon, label, onClick }) {
  return (
    <Button
      variant="ghost"
      onClick={onClick}
      className={`flex h-14 flex-col gap-1 rounded-2xl ${active ? 'border border-cyan-400/20 bg-cyan-400/15 text-cyan-100' : 'text-slate-300'}`}
    >
      {icon}
      <span className="text-[11px]">{label}</span>
    </Button>
  );
}
