const toNumber = (value) => {
  const parsed = parseFloat(String(value ?? '').replace(',', '.'))
  return Number.isFinite(parsed) ? parsed : 0
}

const formatNumber = (value, digits = 4) => (Number.isFinite(value) ? value.toFixed(digits) : '0')

